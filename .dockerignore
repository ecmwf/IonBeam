# Allowlist: the dist stage builds the workspace wheels from these manifests and
# member sources; the pygeoapi image copies its provider module from the same
# tree. Everything else stays out of the build context.
*
!pyproject.toml
!uv.lock
!ionbeam
!ionbeam-client
!ionbeam-legacy-api
!data-sources
!exporters

# Junk inside the allowed trees.
**/node_modules
**/__pycache__
**/.venv
**/.pytest_cache
**/.mypy_cache
**/*.egg-info
**/dist
**/build
