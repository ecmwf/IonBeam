# pygeoapi web server for ionbeam: the upstream image plus geopandas/pyarrow so
# its Parquet provider can read the canonical GeoParquet dataset windows straight
# from the object store (or a mounted volume). The venv is upstream's own
# contract — its entrypoint execs /venv/bin/gunicorn, which the base image does
# not ship — and --system-site-packages keeps the system pygeoapi visible.
FROM geopython/pygeoapi:0.23.4

RUN python3 -m venv --system-site-packages /venv \
    && /venv/bin/python3 -m pip install --no-cache-dir geopandas pyarrow gunicorn

# Canonical-store provider: upstream's Parquet provider with the s3fs path
# replaced by pyarrow-native S3 (SeaweedFS versioned buckets break s3fs's
# file/dir detection).
COPY exporters/pygeoapi/ionbeam_parquet.py /venv/lib/python3.12/site-packages/ionbeam_parquet.py

ENV PATH="/venv/bin:${PATH}"

# Upstream defaults to gevent, which suits many idle connections and cheap
# Python handlers. This server instead spends its time in pyarrow: reads go
# through the AWS C++ SDK in pyarrow._s3fs, which gevent cannot monkey-patch,
# so one S3 read blocks every greenlet sharing that worker. Separate processes
# keep a slow window read off the other requests.
ENV WSGI_WORKER_CLASS=sync

# Collections whose dataset has no built windows yet fail provider init; skip
# them in the startup OpenAPI generation instead of refusing to boot — they
# serve as soon as their first window lands.
ENV PYGEOAPI_OPENAPI_GENERATE_FAIL_ON_INVALID_COLLECTION=false
